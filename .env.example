# Все переменные, доступные клиенту, должны начинаться с VITE_
VITE_APP_NAME="ENERGY LAUNCH"
# Режим источника данных: demo – демонстрационные сценарии, local – только данные из IndexedDB
VITE_DATA_MODE=demo
# Имя базы IndexedDB (Dexie)
VITE_DB_NAME=energy-launch
# Принудительная версия набора правил (пусто – использовать активную из src/config/rules)
VITE_RULESET_VERSION=
# Набор данных: auto – кейс 4 из public/case4 (если есть), synthetic – синтетический демо-портфель
VITE_DATASET=auto
# Подробное логирование конечного автомата в консоль
VITE_DEBUG_STATE_MACHINE=false
# Хранилище: auto – PostgreSQL через API, если сервер запущен (npm run api), иначе браузер; server – только сервер; browser – без сервера
VITE_STORAGE=auto
# Адрес API хранилища (в разработке Vite проксирует /api на API_PROXY_TARGET, в Docker – nginx)
VITE_API_URL=/api

# --- Сервер хранилища (npm run api), переменные читает только сервер ---
# PostgreSQL: postgres://пользователь:пароль@127.0.0.1:5432/energy_launch. Пусто – встроенный PostgreSQL (PGlite) в PGLITE_DIR.
# Реальный пароль – только в .env (не коммитится).
DATABASE_URL=
PGLITE_DIR=.data/pglite
API_HOST=127.0.0.1
API_PORT=8787
